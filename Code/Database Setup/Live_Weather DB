-- DROP TABLE IF EXISTS s1118832.sdi_weather_live;

CREATE TABLE IF NOT EXISTS s1118832.sdi_weather_live
(
    id integer NOT NULL DEFAULT nextval('sdi_weather_live_id_seq'::regclass),
    "timestamp" timestamp with time zone NOT NULL,
    geom geometry(Point,4326) NOT NULL,
    temperature_2m numeric,
    precipitation_1h numeric,
    wind_gusts numeric,
    wind_speed numeric,
    wind_direction numeric,
    station_id integer,
    CONSTRAINT sdi_weather_live_pkey PRIMARY KEY (id),
    CONSTRAINT uq_sdi_live_station UNIQUE (station_id)
)

TABLESPACE pg_default;

ALTER TABLE IF EXISTS s1118832.sdi_weather_live
    OWNER to s1118832;
