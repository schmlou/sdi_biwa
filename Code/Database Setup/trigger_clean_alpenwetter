-- FUNCTION: s1118832.fn_sdi_clean_alpenwetter()

-- DROP FUNCTION IF EXISTS s1118832.fn_sdi_clean_alpenwetter();

CREATE OR REPLACE FUNCTION s1118832.fn_sdi_clean_alpenwetter()
    RETURNS trigger
    LANGUAGE 'plpgsql'
    COST 100
    VOLATILE NOT LEAKPROOF
AS $BODY$
BEGIN
    DELETE FROM s1118832.sdi_dwd_alpenwetter
    WHERE issued_at < (SELECT MAX(issued_at) FROM s1118832.sdi_dwd_alpenwetter);
    
    RETURN NEW;
END;
$BODY$;

ALTER FUNCTION s1118832.fn_sdi_clean_alpenwetter()
    OWNER TO s1118832;
