CREATE TABLE IF NOT EXISTS sdi_weather_history_7d (
    id SERIAL PRIMARY KEY,
    grid_id VARCHAR(50) NOT NULL,
    source VARCHAR(50) NOT NULL,
    timestamp TIMESTAMPTZ NOT NULL,
    geom GEOMETRY(Point, 4326) NOT NULL,
    temperature_2m NUMERIC,
    precipitation_1h NUMERIC,
    wind_gusts NUMERIC,
    soil_moisture NUMERIC,
    snow_depth NUMERIC
);

-- Performance indices for spatial bounds and dashboard dashboard queries
CREATE INDEX IF NOT EXISTS idx_sdi_weather_history_geom ON sdi_weather_history_7d USING GIST(geom);
CREATE INDEX IF NOT EXISTS idx_sdi_history_grid_time ON sdi_weather_history_7d(grid_id, timestamp DESC);

-- PL/pgSQL Function: Deletes records older than 7 days relative to NOW()
CREATE OR REPLACE FUNCTION fn_sdi_clean_weather_history_7d()
RETURNS TRIGGER AS $$
BEGIN
    DELETE FROM sdi_weather_history_7d 
    WHERE timestamp < NOW() - INTERVAL '7 days';
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Trigger: Executes the cleanup function once per batch insert statement
CREATE OR REPLACE TRIGGER trg_sdi_clean_weather_history
AFTER INSERT ON sdi_weather_history_7d
FOR EACH STATEMENT
EXECUTE FUNCTION fn_sdi_clean_weather_history_7d();