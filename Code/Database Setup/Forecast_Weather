CREATE TABLE IF NOT EXISTS sdi_weather_forecast (
    id SERIAL PRIMARY KEY,
    grid_id VARCHAR(50) NOT NULL,
    source VARCHAR(50) NOT NULL,
    forecast_time TIMESTAMPTZ NOT NULL, -- Target timestamp in the future
    geom GEOMETRY(Point, 4326) NOT NULL,
    temperature_2m NUMERIC,
    precipitation_prognosis NUMERIC,
    wind_gusts NUMERIC,
    CONSTRAINT unique_sdi_forecast UNIQUE (grid_id, source, forecast_time)
);

-- Performance indices for spatial bounds and time-series filtering
CREATE INDEX IF NOT EXISTS idx_sdi_weather_forecast_geom ON sdi_weather_forecast USING GIST(geom);
CREATE INDEX IF NOT EXISTS idx_sdi_weather_forecast_time ON sdi_weather_forecast(forecast_time);