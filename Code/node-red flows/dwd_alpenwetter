        "func": "const now = new Date();\nconst pad = n => String(n).padStart(2, '0');\n\nconst year = now.getUTCFullYear();\nconst month = pad(now.getUTCMonth() + 1);\nconst day = pad(now.getUTCDate());\n\n// Letzte volle Stunde\nconst hour = pad(now.getUTCHours() - 1);\n\nconst start = `${year}-${month}-${day}T${hour}:00`;\nconst end = `${year}-${month}-${day}T${hour}:00`;\n\nmsg.url = `https://dataset.api.hub.geosphere.at/v1/station/historical/klima-v2-1h?station_ids=6300,6305,9211,9215,9406,12302,12504&parameters=tl,ff,dd,ffx,rr&start=${start}&end=${end}`;\n\nreturn msg;",
