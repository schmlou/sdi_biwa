        "name": "SQL Builder weather_live",
        "func": "const features = msg.payload.features;\nconst timestamp = msg.payload.timestamps[0];\nlet sql = \"\";\n\nfeatures.forEach(f => {\n    const station_id = f.properties.station;\n    const coords = f.geometry.coordinates;\n    const lon = coords[1];\n    const lat = coords[0];\n    const p = f.properties.parameters;\n\n    const tl = p.tl.data[0] ?? 'NULL';\n    const rr = p.rr.data[0] ?? 'NULL';\n    const ffx = p.ffx.data[0] ?? 'NULL';\n    const ff = p.ff.data[0] ?? 'NULL';\n    const dd = p.dd.data[0] ?? 'NULL';\n\n    sql += `INSERT INTO s1118832.sdi_weather_live \n        (timestamp, geom, temperature_2m, precipitation_1h, wind_gusts, wind_speed, wind_direction, station_id)\n    VALUES \n        ('${timestamp}', ST_SetSRID(ST_MakePoint(${lon}, ${lat}), 4326), \n        ${tl}, ${rr}, ${ffx}, ${ff}, ${dd}, ${station_id})\n    ON CONFLICT (station_id) DO UPDATE SET\n        timestamp = EXCLUDED.timestamp,\n        geom = EXCLUDED.geom,\n        temperature_2m = EXCLUDED.temperature_2m,\n        precipitation_1h = EXCLUDED.precipitation_1h,\n        wind_gusts = EXCLUDED.wind_gusts,\n        wind_speed = EXCLUDED.wind_speed,\n        wind_direction = EXCLUDED.wind_direction; `;\n});\n\nmsg.payload = sql;\nreturn msg;",
