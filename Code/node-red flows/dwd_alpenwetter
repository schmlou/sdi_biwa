        "name": "SQL Builder (Upsert & Clean)",
        "func": "const html = msg.payload;\n\n// issued_at\nconst issuedMatch = html.match(/(?<date>\\d{2}\\.\\d{2}\\.\\d{4}), um (?<time>\\d{2}:\\d{2}) Uhr/);\nlet issuedAt = null;\nif (issuedMatch) {\n        const parts = issuedMatch.groups.date.split(\".\");\n        issuedAt = parts[2] + \"-\" + parts[1] + \"-\" + parts[0] + \"T\" + issuedMatch.groups.time + \":00+02:00\";\n}\n\n// next_update_at\nconst nextMatch = html.match(/Nächste Aktualisierung am [^,]+, (?<date>\\d{2}\\.\\d{2}\\.\\d{4}), um (?<time>\\d{2}:\\d{2}) Uhr/);\nlet nextUpdate = null;\nif (nextMatch) {\n        const parts = nextMatch.groups.date.split(\".\");\n        nextUpdate = parts[2] + \"-\" + parts[1] + \"-\" + parts[0] + \"T\" + nextMatch.groups.time + \":00+02:00\";\n}\n\n// Statische Werte\nconst region = \"Deutscher Alpenraum\";\nconst issuer = \"Regionale Wetterberatung Süd\";\nconst federalState = \"Bayern\";\nconst rawHtml = html.replace(/'/g, \"''\"); // Hochkommas escapen!\nconst textContent = html.replace(/<[^>]+>/g, \" \").replace(/\\s+/g, \" \").trim().replace(/'/g, \"''\");\nconst validFrom = issuedAt ? issuedAt.substring(0, 10) : null;\n\n// valid_until\nconst validUntilMatch = html.match(/Weitere Aussichten bis zum [^,]+, (?<date>\\d{2}\\.\\d{2}\\.\\d{4})/);\nlet validUntil = null;\nif (validUntilMatch) {\n        const parts = validUntilMatch.groups.date.split(\".\");\n        validUntil = parts[2] + \"-\" + parts[1] + \"-\" + parts[0];\n}\n\nmsg.payload = `INSERT INTO sdi_dwd_alpenwetter \n    (issued_at, next_update_at, region, issuer, federal_state, raw_html, text_content, valid_from, valid_until, geom) \nVALUES \n    ('${issuedAt}', '${nextUpdate}', '${region}', '${issuer}', '${federalState}', '${rawHtml}', '${textContent}', '${validFrom}', '${validUntil}', \n    ST_SetSRID(ST_MakePoint(12.9764, 47.6323), 4326))\nON CONFLICT (issued_at) DO NOTHING;`;\n\nreturn msg;",
