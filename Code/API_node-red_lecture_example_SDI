        "z": "f6f2187d.f17ca8",
        "name": "function 1",
        "func": "const reports = msg.payload;\nlet sql = \"\";\n\nreports.forEach(r => {\n    // 1. Basic Information Mapping\n    const sid = r.icaoId;\n    const tmp = r.temp ?? 'NULL';\n    const dwp = r.dewp ?? 'NULL';\n    const obs = r.obsTime; // The Unix timestamp from the API\n    const txt = r.rawOb.replace(/'/g, \"''\"); // Escape single quotes for SQL safety\n\n    // 2. Robust Wind Mapping\n    // Checks multiple possible API keys (wdir/windDir and wspd/windSpd)\n    let rawWdir = (r.wdir !== undefined && r.wdir !== null) ? r.wdir : r.windDir;\n    let rawWspd = (r.wspd !== undefined && r.wspd !== null) ? r.wspd : r.windSpd;\n\n    // Convert 'VRB' (Variable) or nulls to database-safe NULL for integer columns\n    const wdir = (rawWdir === null || isNaN(rawWdir)) ? 'NULL' : rawWdir;\n    const wspd = (rawWspd === null || isNaN(rawWspd)) ? 'NULL' : rawWspd;\n\n    // 3. Relative Humidity Calculation (based on Temp and Dewpoint)\n    let hum = 'NULL';\n    if (r.temp !== null && r.dewp !== null) {\n        hum = Math.round(100 * Math.pow((112 - (0.1 * r.temp) + r.dewp) / (112 + (0.9 * r.temp)), 8));\n    }\n\n    // 4. LIVE TABLE: Target the Primary Key (station_id)\n    sql += `INSERT INTO weather_live (station_id, temp_c, humidity, wind_dir, wind_speed_kt, observation_time, raw_text) \n            VALUES ('${sid}', ${tmp}, ${hum}, ${wdir}, ${wspd}, TO_TIMESTAMP(${obs}), '${txt}') \n            ON CONFLICT (station_id) DO UPDATE SET \n            temp_c = EXCLUDED.temp_c, humidity = EXCLUDED.humidity, wind_dir = EXCLUDED.wind_dir, \n            wind_speed_kt = EXCLUDED.wind_speed_kt, observation_time = EXCLUDED.observation_time, raw_text = EXCLUDED.raw_text; `;\n\n    // 5. HISTORY TABLE: Target the unique constraint (unique_hist)\n    sql += `INSERT INTO weather_history (station_id, temp_c, humidity, wind_dir, wind_speed_kt, observation_time, raw_text) \n            VALUES ('${sid}', ${tmp}, ${hum}, ${wdir}, ${wspd}, TO_TIMESTAMP(${obs}), '${txt}')\n            ON CONFLICT ON CONSTRAINT unique_hist DO UPDATE SET \n            temp_c = EXCLUDED.temp_c, humidity = EXCLUDED.humidity, wind_dir = EXCLUDED.wind_dir, wind_speed_kt = EXCLUDED.wind_speed_kt; `;\n\n    // 6. 24H TABLE: Target the unique constraint (unique_24h)\n    sql += `INSERT INTO weather_24h (station_id, temp_c, humidity, wind_dir, wind_speed_kt, observation_time, raw_text) \n            VALUES ('${sid}', ${tmp}, ${hum}, ${wdir}, ${wspd}, TO_TIMESTAMP(${obs}), '${txt}')\n            ON CONFLICT ON CONSTRAINT unique_24h DO UPDATE SET \n            temp_c = EXCLUDED.temp_c, humidity = EXCLUDED.humidity, wind_dir = EXCLUDED.wind_dir, wind_speed_kt = EXCLUDED.wind_speed_kt; `;\n});\n\n// 7. Cleanup: Prune the 24h table of records older than one day\nsql += `DELETE FROM weather_24h WHERE observation_time < NOW() - INTERVAL '24 hours';`;\n\nmsg.payload = sql;\nreturn msg;",
